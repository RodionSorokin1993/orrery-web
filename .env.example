# Everything is optional. Without Sanity variables the site renders typed fixture content.

# Public URL of the deployed site, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity project (create one for free at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Viewer token: lets Draft Mode read unpublished drafts. Never expose it to the browser.
SANITY_API_READ_TOKEN=

# Editor token: only needed once, for `pnpm sanity:seed`.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=
