{
  "name": "orrery-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "content:check": "tsx scripts/content-check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm content:check && pnpm test",
    "lhci": "lhci autorun",
    "sanity:seed": "tsx scripts/seed-sanity.ts"
  },
  "dependencies": {
    "@sanity/document-internationalization": "^6.3.1",
    "@sanity/icons": "^5.4.0",
    "@sanity/image-url": "^2.2.0",
    "@sanity/ui": "^4.4.13",
    "@sanity/vision": "6.25.0",
    "geist": "^1.9.2",
    "next": "16.4.6",
    "next-sanity": "13.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.25.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@10.28.0",
  "description": "Marketing site for Orrery Labs, a fictional AI company. Next.js 16, Sanity, CSS Modules, i18n, generative design.",
  "license": "MIT",
  "author": "Rodion Sorokin",
  "engines": {
    "node": ">=22.12"
  }
